{
  "$schema": "https://tr.designtokens.org/format/",
  "$description": "HDS Core (primitive) tokens — 하나머니 브랜드 원시값. Figma [공식] Hana Experience System(HES)의 base 변수 컬렉션(124개)과 완전 동기화(2026-07-20, 브랜치 0F4A8OTZzApAJIjFjeQULz). 절대 UI에서 직접 참조하지 말 것. semantic/component 레이어를 통해서만 사용.",
  "color": {
    "$type": "color",
    "teal": {
      "$description": "HES color/teal — 브랜드 틸 램프. 숫자는 HES 명도 스텝(70=가장 밝음, 125=가장 어두움).",
      "70":  { "$value": "#e7faf9" },
      "75":  { "$value": "#d9f0f0" },
      "80":  { "$value": "#b2e8e6" },
      "85":  { "$value": "#89e0dc" },
      "90":  { "$value": "#61d9d2" },
      "95":  { "$value": "#3bd1c8" },
      "100": { "$value": "#13c9be", "$description": "HES primary/lighter" },
      "105": { "$value": "#0aaea7" },
      "110": { "$value": "#00928f", "$description": "HES primary/default" },
      "115": { "$value": "#017a78" },
      "120": { "$value": "#016260" },
      "125": { "$value": "#005856" }
    },
    "grayScale": {
      "$description": "HES color/grayScale — 쿨 그레이 램프(청록 기 섞인 중성색).",
      "white": { "$value": "#ffffff" },
      "5":   { "$value": "#f4f1f5" },
      "10":  { "$value": "#f5f8f9" },
      "15":  { "$value": "#f6f6f6" },
      "20":  { "$value": "#edf4f4" },
      "25":  { "$value": "#e5edef" },
      "30":  { "$value": "#d4e0e2" },
      "35":  { "$value": "#d0d7d7" },
      "40":  { "$value": "#b7c5c8" },
      "50":  { "$value": "#9daab0" },
      "60":  { "$value": "#839097" },
      "70":  { "$value": "#69777e" },
      "80":  { "$value": "#536067" },
      "90":  { "$value": "#374248" },
      "100": { "$value": "#252e33" },
      "black": { "$value": "#000000" }
    },
    "hana": {
      "$description": "하나금융그룹 CI 색상 (HES color/hana).",
      "red":           { "$value": "#da2128" },
      "green":         { "$value": "#009178", "$description": "하나그린 — HES/color/brand/primary. 제품의 주 브랜드색." },
      "darkgreen":     { "$value": "#1e4e45" },
      "palegreen":     { "$value": "#d7ede6" },
      "lightgreen":    { "$value": "#a7d8b7" },
      "pointgreen":    { "$value": "#cbdb2c" },
      "digitalgreen":  { "$value": "#a2fb62" },
      "digitalpink":   { "$value": "#f959c4" },
      "digitalpurple": { "$value": "#b51dfd" },
      "digitalyellow": { "$value": "#fdf87c" },
      "digitalorange": { "$value": "#faa602" }
    },
    "purple": {
      "$description": "HES color/purple — 보조 포인트 색.",
      "50":  { "$value": "#f4f1f5" },
      "60":  { "$value": "#eeedf4" },
      "100": { "$value": "#844883", "$description": "HES secondary/default" },
      "110": { "$value": "#6242bc" }
    },
    "orange": {
      "100": { "$value": "#ff5833", "$description": "HES status/warning. 흰 텍스트 대비 3.14:1 — 큰 텍스트/아이콘 한정(guidelines/color.md 참조)." }
    },
    "pink": {
      "100": { "$value": "#ec4361", "$description": "HES status/err." }
    }
  },
  "dimension": {
    "$type": "dimension",
    "space": {
      "$description": "HES spacing 스케일. 키는 HES 스텝 번호(spacing/0 ~ spacing/160).",
      "0":   { "$value": "0px" },
      "10":  { "$value": "2px" },
      "20":  { "$value": "4px" },
      "30":  { "$value": "6px" },
      "40":  { "$value": "8px" },
      "50":  { "$value": "10px" },
      "60":  { "$value": "12px" },
      "70":  { "$value": "14px" },
      "80":  { "$value": "16px" },
      "90":  { "$value": "20px" },
      "100": { "$value": "24px" },
      "110": { "$value": "32px" },
      "120": { "$value": "40px" },
      "130": { "$value": "48px" },
      "140": { "$value": "56px" },
      "150": { "$value": "64px" },
      "160": { "$value": "72px" }
    },
    "radius": {
      "$description": "HES border/radius 램프 전체(키 = HES 스텝 번호). xs~xl 은 HDS 관례 별칭: xs=10(4) · sm=30(8) · md=50(12) · lg=80(20) · xl=90(24). HES theme 의 borderRadius 의미 스케일과의 대응: xxs=10 · xs=30 · s=50 · m=60 · ml=70 · l=80 · xl=90.",
      "0":  { "$value": "0px" },
      "10": { "$value": "4px" },
      "20": { "$value": "6px" },
      "30": { "$value": "8px" },
      "40": { "$value": "10px" },
      "50": { "$value": "12px" },
      "60": { "$value": "14px" },
      "70": { "$value": "16px" },
      "80": { "$value": "20px" },
      "90": { "$value": "24px" },
      "xs": { "$value": "{dimension.radius.10}" },
      "sm": { "$value": "{dimension.radius.30}" },
      "md": { "$value": "{dimension.radius.50}" },
      "lg": { "$value": "{dimension.radius.80}" },
      "xl": { "$value": "{dimension.radius.90}" },
      "full": { "$value": "9999px", "$description": "HES border/radius/circle(50) 의 CSS 각색 — Figma 의 50은 '높이 절반' 관행값이라 웹에선 pill 보장값 9999px 사용." }
    },
    "borderWidth": {
      "$description": "HES border/width — 1px/2px 2단계 + none.",
      "none": { "$value": "0px" },
      "1": { "$value": "1px" },
      "2": { "$value": "2px" }
    },
    "sizing": {
      "$description": "HES sizing 램프(키 = HES 스텝 번호). 아이콘·버튼 높이 등 고정 크기용 — spacing 과 달리 중간 스텝(15·103~107·115·133~137·145)이 있다. 컴포넌트 간격에는 space, 박스 크기에는 sizing 을 쓸 것.",
      "10":  { "$value": "2px" },
      "15":  { "$value": "3px" },
      "20":  { "$value": "4px" },
      "30":  { "$value": "6px" },
      "40":  { "$value": "8px" },
      "50":  { "$value": "12px" },
      "60":  { "$value": "14px" },
      "70":  { "$value": "16px" },
      "80":  { "$value": "18px" },
      "90":  { "$value": "20px" },
      "100": { "$value": "24px" },
      "103": { "$value": "26px" },
      "105": { "$value": "28px" },
      "107": { "$value": "30px" },
      "110": { "$value": "32px" },
      "115": { "$value": "36px" },
      "120": { "$value": "40px" },
      "130": { "$value": "48px" },
      "133": { "$value": "50px" },
      "135": { "$value": "52px" },
      "137": { "$value": "54px" },
      "140": { "$value": "56px" },
      "145": { "$value": "60px" },
      "150": { "$value": "64px" },
      "160": { "$value": "72px" }
    }
  },
  "fontFamily": {
    "$type": "fontFamily",
    "sans": { "$value": ["Spoqa Han Sans Neo", "Pretendard", "system-ui", "sans-serif"], "$description": "HES font/family/spoqa. Spoqa 미로드 환경 폴백으로 Pretendard 유지." },
    "mono": { "$value": ["JetBrains Mono", "ui-monospace", "monospace"] }
  },
  "fontWeight": {
    "$type": "fontWeight",
    "$description": "HES font/weight — 3단계(300/400/700)만 사용.",
    "light": { "$value": 300 },
    "regular": { "$value": 400 },
    "bold": { "$value": 700 }
  },
  "dimensionFont": {
    "$type": "dimension",
    "size": {
      "$description": "HES font/size 램프 전체(키 = HES 스텝 번호). xs~3xl 은 HDS 관례 별칭: xs=10(12) · sm=30(14) · md=50(16, body 기본) · lg=80(20) · xl=100(24) · 2xl=130(32) · 3xl=150(40). HES theme 의 의미 스케일 대응: body xxs=10 · xs=20 · s=30 · m=40 · default=50 · l=70 · xl=80 · xxl=90 · xxxl=100, headline s=110 · m=120 · l=130 · xl=140 · xxl=150.",
      "10":  { "$value": "12px" },
      "20":  { "$value": "13px" },
      "30":  { "$value": "14px" },
      "40":  { "$value": "15px" },
      "50":  { "$value": "16px" },
      "60":  { "$value": "17px" },
      "70":  { "$value": "18px" },
      "80":  { "$value": "20px" },
      "90":  { "$value": "22px" },
      "100": { "$value": "24px" },
      "110": { "$value": "26px" },
      "120": { "$value": "28px" },
      "130": { "$value": "32px" },
      "140": { "$value": "36px" },
      "150": { "$value": "40px" },
      "xs":  { "$value": "{dimensionFont.size.10}" },
      "sm":  { "$value": "{dimensionFont.size.30}" },
      "md":  { "$value": "{dimensionFont.size.50}" },
      "lg":  { "$value": "{dimensionFont.size.80}" },
      "xl":  { "$value": "{dimensionFont.size.100}" },
      "2xl": { "$value": "{dimensionFont.size.130}" },
      "3xl": { "$value": "{dimensionFont.size.150}" }
    },
    "scale": { "$value": 10, "$type": "number", "$description": "HES font/size/scale — rem 환산 기준값(1rem = 10px 관행). 참조용 데이터." }
  },
  "lineHeight": {
    "$type": "number",
    "$description": "HES line/height (키 = HES 스텝 번호): 100=100% · 200=128%(헤드라인) · 300=132%(본문). CSS unitless 로 각색.",
    "100": { "$value": 1 },
    "200": { "$value": 1.28 },
    "300": { "$value": 1.32 }
  },
  "duration": {
    "$type": "duration",
    "$description": "HES 변수에 모션 정의 없음 — HDS 자체 값 유지.",
    "fast": { "$value": "120ms" },
    "base": { "$value": "200ms" },
    "slow": { "$value": "320ms" }
  },
  "cubicBezier": {
    "$type": "cubicBezier",
    "standard": { "$value": [0.2, 0, 0, 1] },
    "emphasized": { "$value": [0.3, 0, 0.1, 1] }
  }
}
